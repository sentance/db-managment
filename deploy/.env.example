# pgcp deployment settings. Copy to .env (install.sh does this). Contains no secrets:
# secrets live in deploy/secrets/ and certificates in deploy/certs/, both generated by install.sh.

# Image tag for locally built images.
PGCP_VERSION=dev

# Where the panel is published on the host. Keep it on loopback or a private/bridge address and put
# the existing edge proxy (Caddy) with TLS in front of it.
PGCP_PANEL_BIND=127.0.0.1
PGCP_PANEL_PORT=8480

# Host name clients use for instances published on a public port; also added to their TLS certificates.
PGCP_PUBLIC_HOST=

# Optional link to an external SQL editor (CloudBeaver, pgAdmin).
PGCP_SQL_EDITOR_URL=

# Agent state: instance compose files, TLS material, operation journal. Must be an absolute host path.
PGCP_DATA_DIR=/var/lib/pgcp

# Name of this server in the panel.
PGCP_SERVER_NAME=local

# Session cookies are HTTPS-only. Set to false only for local testing over plain HTTP.
PGCP_COOKIE_SECURE=true
